# Production API (default if unset)
NEXT_PUBLIC_API_BASE_URL=https://handkerchief-apis.addonops.com/v1

# Local backend only — uncomment when running backend locally.
# Port 5000 is taken by macOS AirPlay (Control Center), so the local API is 5001.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:5001/v1
